# MongoDB Atlas connection string
MONGODB_URI=

# JWT session signing secret (openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public URL of the deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cloudinary — optional, used only for hosted page images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=folio
